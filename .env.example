# ASES 本地环境变量样例
# 复制为 .env 后填写真实值。.env 已被 .gitignore 排除，绝不入库。
# 密钥一律用 SecretStr 承载，禁止写进代码或提交到仓库。

# ---------- 运行时 ----------
ASES_ENVIRONMENT=local
ASES_LOG_LEVEL=INFO
ASES_LOG_FORMAT=json

# ---------- 数据库 ----------
ASES_DATABASE_URL=postgresql+asyncpg://ases:ases@localhost:5432/ases
ASES_DATABASE_POOL_SIZE=10
ASES_DATABASE_MAX_OVERFLOW=20

# ---------- 对象存储（MinIO / S3）----------
# 宿主机端口与 docker-compose.yml 的 MINIO_PORT 默认值一致（9000 常被占用）。
ASES_S3_ENDPOINT_URL=http://localhost:9100
ASES_S3_REGION=us-east-1
ASES_S3_BUCKET=ases-artifacts
ASES_S3_ACCESS_KEY=minioadmin
ASES_S3_SECRET_KEY=minioadmin
# AWS 真实凭证用标准环境变量，避免与本项目配置混淆
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# 没配 S3 时的本地文件系统后端根目录
ASES_LOCAL_STORE_ROOT=/tmp/ases-artifacts

# ---------- 观测 ----------
ASES_OTEL_ENABLED=false
ASES_OTEL_ENDPOINT=http://localhost:4318
ASES_LANGFUSE_ENABLED=false
ASES_LANGFUSE_HOST=http://localhost:3000
ASES_LANGFUSE_PUBLIC_KEY=
ASES_LANGFUSE_SECRET_KEY=

# ---------- 可观测性栈（observability profile）----------
# Langfuse 用的 Redis 口令 —— 必填。Langfuse 的 worker 会把未设置的
# REDIS_AUTH 转成字符串 "undefined" 去 AUTH，无口令的 Redis 直接拒绝连接。
LANGFUSE_REDIS_PASSWORD=langfuse-local-redis-pass
# Langfuse 自己的数据库名 —— 不能与 ASES 共用同一个库：它的 prisma migrate
# 遇到非空 schema 会报 P3005 拒绝执行。
LANGFUSE_DB_NAME=langfuse

# ---------- 执行器（阶段一仅需其一）----------
ASES_EXECUTOR_DEFAULT=claude_code
# Claude Code
ASES_CLAUDE_CODE_BIN=claude
ASES_CLAUDE_CODE_API_KEY=
# Codex
ASES_CODEX_BIN=codex

# ---------- 沙箱 ----------
ASES_SANDBOX_IMAGE=ases/sandbox:latest
ASES_SANDBOX_NETWORK=none
ASES_WORKSPACE_ROOT=/tmp/ases-workspaces
ASES_WORKSPACE_LEASE_TTL_SECONDS=3600
